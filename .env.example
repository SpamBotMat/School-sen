# Скопируй в .env (локально) или задай в Render → Environment. Файл .env в git НЕ попадает.

# Окружение: prod | dev | test
APP_ENV=prod

# Токен бота от @BotFather
BOT_TOKEN=

# Адрес сервиса (на Render подставится сам из RENDER_EXTERNAL_URL)
# PUBLIC_URL=https://school-sensor.onrender.com

# Postgres от Neon — ПРЯМОЕ подключение (без "-pooler" в адресе)
# postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Ключ шифрования паролей NetSchool: python -m app genkey
# ВАЖНО: не меняй и не теряй — иначе всем придётся заново ввести пароль.
CREDENTIALS_KEY=

# Telegram ID админов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=

# Секрет для /tick?key=... (cron-job.org будит сервис). Любая длинная случайная строка.
TICK_KEY=

# Сайт NetSchool школы
NETSCHOOL_URL=http://school.trsosh.edu.tm
SCHOOL_NAME=СТРСОШ им. А.С. Пушкина
CITY_NAME=Ашхабад
WEATHER_LAT=37.95
WEATHER_LON=58.38

# Как часто сбрасывать изменения в БД, секунд (Neon засыпает, пока его не трогают; реже — меньше «часов» Neon)
DB_FLUSH_SECONDS=900
LOG_LEVEL=INFO

# ── Только для разработки ──
# DEMO_MODE=1          # фейковый NetSchool с демо-данными
# DEV_MODE=1           # ?dev_user=1 в Mini App без Telegram (НИКОГДА на проде)
# USE_POLLING=1        # бот без вебхука (локально)
# SCHEDULER_ENABLED=0  # выключить фоновые опросы
# FAKE_NOW=2026-12-08T08:20   # «заморозить» время (только с DEMO_MODE)
# WEBHOOK_SECRET=      # по умолчанию выводится из токена
# DATA_DIR=./data      # где лежит SQLite без DATABASE_URL
